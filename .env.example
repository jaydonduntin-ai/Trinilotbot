# Required
DISCORD_BOT_TOKEN=
DISCORD_HEAVY_COMMAND_MAX_CONCURRENT=2

# Automatic /target discovery
ROBLOX_TARGET_MIN_VALUE=150000
ROBLOX_TARGET_MIN_RAP=150000
ROBLOX_TARGET_MAX_CANDIDATES=500
ROBLOX_TARGET_MAX_PRESENCE_CANDIDATES=2500
ROBLOX_TARGET_SCAN_WAVE_SIZE=500
ROBLOX_TARGET_SCAN_TIME_BUDGET_MS=45000
ROBLOX_TARGET_TRUSTED_RAP_TTL_MS=900000
ROBLOX_TARGET_LEADERBOARD_PAGES_PER_REFRESH=20
ROBLOX_TARGET_LIVE_CACHE_INTERVAL_MS=300000
ROBLOX_TARGET_LIVE_CACHE_TTL_MS=480000
ROBLOX_TARGET_LIVE_CACHE_SCAN_LIMIT=500
ROBLOX_TARGET_LIVE_CACHE_BATCH_DELAY_MS=1200
ROBLOX_TARGET_LIVE_CACHE_BACKOFF_MS=600000
ROBLOX_PRESENCE_API_BACKOFF_MS=180000
ROBLOX_PRESENCE_SCHEDULER_SPACING_MS=3000
ROBLOX_GAME_TARGET_MAX_CANDIDATES=1200
ROBLOX_TARGET_MAX_ACTIVE_TO_VERIFY=160
ROBLOX_TARGET_POOL_MAX_SIZE=5000
ROBLOX_TARGET_POOL_TTL_MS=43200000
ROBLOX_TARGET_RECENT_CHECK_COOLDOWN_MS=900000
ROBLOX_TARGET_SEED_ITEM_COUNT=12
ROBLOX_TARGET_OWNERS_PER_ITEM=20
ROBLOX_TARGET_SEED_MIN_ITEM_RAP=75000

# Optional providers
ROBLOX_SOURCE_ROLIMONS_ENABLED=true
# Optional override if Jailbreak Trading Network publishes/moves its public feed endpoint.
# Leave blank to use the public Trading Offers page.
JBTN_PUBLIC_FEED_URL=
# MM2: RBLXValue v2 user inventory support
ROBLOX_RBLXVALUE_API_KEY=
# Optional compatible HTTPS user-inventory adapters. Templates may use {username} or {userId}.
ROBLOX_MM2_PROVIDER_URL=
ROBLOX_ADOPT_ME_PROVIDER_URL=

# /scan background presence watcher
ROBLOX_SCAN_WATCH_INTERVAL_MS=120000
# Optional explicit storage paths. When a Railway Volume is attached, the bot
# automatically uses RAILWAY_VOLUME_MOUNT_PATH and these can stay blank.
ROBLOX_SCAN_WATCHLIST_PATH=
ROBLOX_TARGET_HISTORY_PATH=
ROBLOX_MM2_VALUE_WATCHLIST_PATH=
ROBLOX_ALERT_SUBSCRIBERS_PATH=

# Existing optional monitor settings
ROBLOX_MONITOR_CHANNEL_ID=
ROBLOX_MONITOR_INTERVAL_MS=3600000
ROBLOX_MONITOR_MIN_VALUE=450000
ROBLOX_MONITOR_USERNAMES=

# Optional verified account-association providers
# Bloxlink v4 API key. When set, /rbx2dc and /dc2rb query Bloxlink directly.
BLOXLINK_API_KEY=
# Set true to use guild-scoped Bloxlink lookups in Discord servers.
BLOXLINK_USE_GUILD_LOOKUPS=false
ROBLOX_TO_DISCORD_SOURCE_URL=
DISCORD_TO_ROBLOX_SOURCE_URL=
